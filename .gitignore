# Exports de workflows de n8n: llevan tokens y credenciales embebidos en texto
# plano. Se guardan en la raíz solo como referencia; nunca deben commitearse.
/*.json
!/composer.json
!/package.json
!/package-lock.json
!/phpunit.xml
# El build de Vite del admin SÍ se commitea, igual que los de webform, installer
# y /public/build. No es por gusto: el Dockerfile no tiene etapa de Node —el
# .dockerignore habla de un `COPY --from=node_builder` que no existe— así que
# nadie compila el admin en el deploy. Cuando esto estaba ignorado, el CSS de
# producción se quedó en el build que alguien había corrido a mano, y cada clase
# nueva de Tailwind escrita después salía sin generar: el botón se veía gris, sin
# un error en ningún log.
#
# 🔴 Si cambiás clases de Tailwind, hay que correr el build Y commitearlo:
#     cd packages/Webkul/Admin && npm run build

# Caché de resultados de PHPUnit: artefacto local
/.phpunit.cache

# Dumps de base de datos (datos de clientes, nunca al repo)
*.sql
