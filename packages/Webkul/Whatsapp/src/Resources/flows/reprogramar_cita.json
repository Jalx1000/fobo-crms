{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "APPT_SELECT": [
      "SLOT_DATE",
      "SUMMARY"
    ],
    "SLOT_DATE": [
      "SLOT_TIME"
    ],
    "SLOT_TIME": [
      "SUMMARY"
    ],
    "SUMMARY": []
  },
  "screens": [
    {
      "id": "APPT_SELECT",
      "title": "Tus citas",
      "data": {
        "heading": {
          "type": "string",
          "__example__": "¿Qué cita querés cancelar?"
        },
        "appointments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "77587",
              "title": "Mié 15/10 · 10:00",
              "description": "Juan Pérez · CAROLINA ROJAS"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextSubheading",
            "text": "${data.heading}"
          },
          {
            "type": "RadioButtonsGroup",
            "name": "appointment",
            "label": "Cita",
            "required": true,
            "data-source": "${data.appointments}"
          },
          {
            "type": "Footer",
            "label": "Siguiente",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "appointment": "${form.appointment}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SLOT_DATE",
      "title": "Nuevo día",
      "data": {
        "dates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "2026-10-16",
              "title": "Jue 16/10"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Elegí el nuevo día. Mostramos los horarios libres del mismo doctor."
          },
          {
            "type": "Dropdown",
            "name": "date",
            "label": "Día",
            "required": true,
            "data-source": "${data.dates}"
          },
          {
            "type": "Footer",
            "label": "Ver horas",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "date": "${form.date}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SLOT_TIME",
      "title": "Nueva hora",
      "data": {
        "heading": {
          "type": "string",
          "__example__": "Horarios del Jue 16/10"
        },
        "times": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "10:00",
              "title": "10:00"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextSubheading",
            "text": "${data.heading}"
          },
          {
            "type": "RadioButtonsGroup",
            "name": "time",
            "label": "Hora",
            "required": true,
            "data-source": "${data.times}"
          },
          {
            "type": "Footer",
            "label": "Siguiente",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "time": "${form.time}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SUMMARY",
      "title": "Confirmar cambio",
      "terminal": true,
      "success": true,
      "data": {
        "heading": {
          "type": "string",
          "__example__": "Revisá el cambio"
        },
        "detail": {
          "type": "string",
          "__example__": "Antes: Mié 15/10 · 10:00\nAhora: Jue 16/10 · 10:00"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.heading}"
          },
          {
            "type": "TextBody",
            "text": "${data.detail}"
          },
          {
            "type": "Footer",
            "label": "Confirmar",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "confirm": "si"
              }
            }
          }
        ]
      }
    }
  ]
}
