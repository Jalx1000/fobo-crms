{
  "info": {
    "name": "Tessa · Agente IA — Ofrecer servicios",
    "_postman_id": "b3a1e2c4-5d6f-47a8-9b10-tessaagente01",
    "description": "Endpoints que el Agente IA usa para ofrecer servicios/precios/promos, consultar disponibilidad y agendar en el CRM Tessa. Validado en producción 2026-11-04.\n\nConfigurar la variable `token` (Bearer Sanctum) y, si hace falta, `base_url`. El catálogo y la disponibilidad pública NO requieren token.\n\nReglas clave:\n- Cotizá `zones[].current_price` (no el `price` del servicio) y pedí el catálogo con `branch_id=1` (Santa Cruz) para que apliquen las promos.\n- `duration_minutes` = duración de la zona elegida; va a disponibilidad y a `schedule_to`.\n- Agenda única: `doctor_id = 1`. Todo por texto (Flows apagados).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "https://tessa.sofopolis.com" },
    { "key": "token", "value": "" },
    { "key": "branch_id", "value": "1" },
    { "key": "doctor_id", "value": "1" },
    { "key": "product_id", "value": "508" },
    { "key": "person_id", "value": "3456" },
    { "key": "zone_duration", "value": "60" },
    { "key": "date", "value": "2026-11-05" },
    { "key": "conversation_id", "value": "1" }
  ],
  "item": [
    {
      "name": "0. Auth · Obtener token",
      "item": [
        {
          "name": "POST login (una vez)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"agente@tessa.com\",\n  \"password\": \"<password del usuario dedicado>\",\n  \"device_name\": \"agente-ia\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "login"]
            },
            "description": "Devuelve el token Sanctum. Copiarlo a la variable `token` de la colección/entorno."
          }
        }
      ]
    },
    {
      "name": "1. Catálogo (público)",
      "item": [
        {
          "name": "GET servicios + zonas + precio vigente",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/public/products?branch_id={{branch_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "public", "products"],
              "query": [
                { "key": "branch_id", "value": "{{branch_id}}", "description": "Sucursal (Santa Cruz = 1). Aplica las promos vigentes." }
              ]
            },
            "description": "Catálogo completo. Cotizar `zones[].current_price` (ya trae promo). Ignorar el `price` del servicio."
          },
          "response": [
            {
              "name": "200 OK (ejemplo real, recortado)",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/public/products?branch_id=1&q=HIFU",
                  "host": ["{{base_url}}"],
                  "path": ["api", "public", "products"],
                  "query": [
                    { "key": "branch_id", "value": "1" },
                    { "key": "q", "value": "HIFU" }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"data\": [\n    {\n      \"id\": 508,\n      \"sku\": \"HIFU\",\n      \"name\": \"HIFU\",\n      \"specialty\": \"Faciales de rejuvenecimiento\",\n      \"categories\": [\"Facial\"],\n      \"description\": \"Tecnología HIFU 25D PRO MAX 360°...\",\n      \"frequency_text\": \"Según la edad, la calidad de la piel y el grado de flacidez: cada 3, 4, 6 meses o una vez al año...\",\n      \"min_interval_days\": 90,\n      \"price\": \"120,00 BOB\",\n      \"duration_minutes\": null,\n      \"zones\": [\n        { \"id\": 20, \"name\": \"Rostro completo\", \"duration_minutes\": 60, \"price\": \"1500.0000\", \"current_price\": 1500 },\n        { \"id\": 21, \"name\": \"Rostro completo + papada\", \"duration_minutes\": 75, \"price\": \"1800.0000\", \"current_price\": 1800 },\n        { \"id\": 22, \"name\": \"Rostro completo + papada + cuello\", \"duration_minutes\": 90, \"price\": \"2190.0000\", \"current_price\": 2190 },\n        { \"id\": 19, \"name\": \"Óvalo facial + mandíbula + papada\", \"duration_minutes\": 60, \"price\": \"900.0000\", \"current_price\": 900 },\n        { \"id\": 23, \"name\": \"Papada + cuello\", \"duration_minutes\": 45, \"price\": \"800.0000\", \"current_price\": 800 }\n      ]\n    },\n    {\n      \"id\": 515,\n      \"sku\": \"HIFU-CORPORAL\",\n      \"name\": \"HIFU Corporal\",\n      \"specialty\": \"Reducción de grasa localizada y modelado\",\n      \"categories\": [\"Corporal\"],\n      \"frequency_text\": \"Protocolo de 3 sesiones, cada una con un intervalo de 30 a 40 días.\",\n      \"zones\": [\n        { \"id\": 24, \"name\": \"Papada y región submentoniana\", \"duration_minutes\": 60, \"current_price\": 1090 },\n        { \"id\": 26, \"name\": \"Abdomen bajo\", \"duration_minutes\": 60, \"current_price\": 1090 }\n      ]\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "GET buscar servicio (q=)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/public/products?branch_id={{branch_id}}&q=HIFU",
              "host": ["{{base_url}}"],
              "path": ["api", "public", "products"],
              "query": [
                { "key": "branch_id", "value": "{{branch_id}}" },
                { "key": "q", "value": "HIFU", "description": "Filtra por nombre o SKU del servicio." }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Disponibilidad",
      "item": [
        {
          "name": "GET available-slots (Bearer)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/doctors/{{doctor_id}}/available-slots?date={{date}}&days=7&duration_minutes={{zone_duration}}",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", "{{doctor_id}}", "available-slots"],
              "query": [
                { "key": "date", "value": "{{date}}", "description": "YYYY-MM-DD" },
                { "key": "days", "value": "7", "description": "1-30" },
                { "key": "duration_minutes", "value": "{{zone_duration}}", "description": "Duración de la zona elegida (15-480)." }
              ]
            },
            "description": "Disponibilidad real de la agenda única. Ofrecer solo slots con status=available."
          }
        },
        {
          "name": "GET slots (público, pruebas)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/doctors/{{doctor_id}}/slots?date={{date}}&days=2&duration_minutes={{zone_duration}}",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", "{{doctor_id}}", "slots"],
              "query": [
                { "key": "date", "value": "{{date}}" },
                { "key": "days", "value": "2" },
                { "key": "duration_minutes", "value": "{{zone_duration}}" }
              ]
            }
          },
          "response": [
            {
              "name": "200 OK (ejemplo real, recortado)",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/doctors/1/slots?date=2026-11-05&days=2&duration_minutes=60",
                  "host": ["{{base_url}}"],
                  "path": ["api", "doctors", "1", "slots"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"doctor_id\": 1,\n  \"from\": \"2026-11-05\",\n  \"days\": 2,\n  \"duration_minutes\": 60,\n  \"schedule\": [\n    {\n      \"date\": \"2026-11-05\",\n      \"slots\": [\n        { \"start_time\": \"08:00\", \"end_time\": \"09:00\", \"status\": \"available\" },\n        { \"start_time\": \"09:00\", \"end_time\": \"10:00\", \"status\": \"available\" }\n      ]\n    }\n  ]\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "3. Pacientes (Bearer)",
      "item": [
        {
          "name": "GET buscar paciente",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/contacts/persons/search?query=Juan",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "contacts", "persons", "search"],
              "query": [{ "key": "query", "value": "Juan", "description": "Nombre o teléfono" }]
            }
          }
        },
        {
          "name": "POST crear paciente",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan Pérez\",\n  \"emails\": [],\n  \"contact_numbers\": [\n    { \"value\": \"+591700000000\", \"label\": \"work\" }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/contacts/persons",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "contacts", "persons"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Crear cita (Bearer)",
      "item": [
        {
          "name": "POST agendar cita",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"meeting\",\n  \"schedule_from\": \"2026-11-05 09:00:00\",\n  \"schedule_to\": \"2026-11-05 10:00:00\",\n  \"title\": \"HIFU - Rostro completo - Juan Pérez\",\n  \"comment\": \"Primera sesión\",\n  \"product_id\": {{product_id}},\n  \"participants\": {\n    \"doctors\": [{{doctor_id}}],\n    \"persons\": [{{person_id}}]\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/activities",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "activities"]
            },
            "description": "schedule_to = schedule_from + duración de la zona. 422 si el slot se ocupó: re-consultar disponibilidad."
          }
        }
      ]
    },
    {
      "name": "5. WhatsApp (agente, Bearer)",
      "item": [
        {
          "name": "GET historial de la conversación",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/whatsapp/conversations/{{conversation_id}}/messages",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "whatsapp", "conversations", "{{conversation_id}}", "messages"]
            }
          }
        },
        {
          "name": "POST responder por texto",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"¡Hola! El HIFU facial (rostro completo) está Bs 1.500 este mes. ¿Querés que te agende?\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/whatsapp/conversations/{{conversation_id}}/messages",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "whatsapp", "conversations", "{{conversation_id}}", "messages"]
            },
            "description": "422 = fuera de la ventana de 24h → derivar a recepción."
          }
        },
        {
          "name": "POST derivar a humano (handoff)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"El paciente pide hablar con recepción\",\n  \"fuera_de_horario\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/whatsapp/conversations/{{conversation_id}}/handoff",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "whatsapp", "conversations", "{{conversation_id}}", "handoff"]
            }
          }
        }
      ]
    }
  ]
}
